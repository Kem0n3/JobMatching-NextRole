<%# views/partials/navbar.ejs %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=browse" />
<header class="navbar-area navbar-container"> 
    <div class="navbar-left">
        <button id="mobileMenuToggle" class="mobile-menu-toggle" aria-label="Toggle menu">☰</button>
        <% if (isAuthenticated && locals.displayNameForNav) { %>
            <span class="navbar-welcome-message">Welcome, <%= locals.displayNameForNav.split(' ')[0] %>!</span>
        <% } %>
    </div>

    <div class="navbar-right">
        <% if (isAuthenticated) { %>
            <a href="/notifications" class="notif-bell" id="notifBell" aria-label="Notifications">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
            </a>
        <% } %>

        <% if (isAuthenticated && locals.displayNameForNav) { %>
            <img src="/assets/profilepic.png" alt="<%= locals.displayNameForNav %>" class="user-avatar-nav">
            <span class="username-display-nav"><%= locals.displayNameForNav %></span>
        <% } %>
    </div>
</header>
